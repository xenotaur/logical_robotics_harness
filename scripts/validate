#!/usr/bin/env bash
set -euo pipefail

log_redirect="${LRH_LOG_REDIRECT:-0}"
args=()

for arg in "$@"; do
    if [ "$arg" = "--log" ]; then
        log_redirect=1
    else
        args+=("$arg")
    fi
done

# Check that lrh CLI is available
if ! command -v lrh >/dev/null 2>&1; then
    echo "ERROR: 'lrh' command not found."
    echo
    echo "You may need to set up your development environment:"
    echo "  scripts/develop"
    echo
    echo "Or install the package manually:"
    echo "  python -m pip install -e \".[dev]\""
    exit 1
fi

if [ "$log_redirect" -eq 1 ]; then
    mkdir -p tmp/logs
    timestamp=$(date +%Y%m%d_%H%M%S)
    logfile="tmp/logs/validate_${timestamp}.log"
    echo "Validating LRH project metadata (logging to ${logfile}) ..."

    set +e
    lrh validate "${args[@]}" > "$logfile" 2>&1
    exit_code=$?
    set -e

    abs_log="$(pwd)/${logfile}"
    if [ "$exit_code" -eq 0 ]; then
        echo "[PASS] lrh validate completed successfully | Log: file://${abs_log}"
    else
        echo "[FAIL] lrh validate failed (exit code ${exit_code}) | Log: file://${abs_log}"
    fi
    exit "$exit_code"
else
    echo "Validating LRH project metadata ..."
    set -x
    lrh validate "${args[@]}"
    { set +x; } 2>/dev/null
    echo
fi