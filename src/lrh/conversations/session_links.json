    {
      "name": "claude-app",
      "pointer_prefix": "claude-app:",
      "scheme": "claude",
      "host": "claude.ai",
      "path_template": "/epitaxy/{id_prefix}{id}",
      "id_prefix": "local_",
      "id_shape": "uuid",
      "status": "verified",
      "note": "Verified by hand with `open`. The epitaxy route is undocumented by Anthropic and may change; treat it as best-effort."
    },
    {
      "name": "codex-app",
